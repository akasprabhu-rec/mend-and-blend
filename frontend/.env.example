# Leave empty in development: the Vite proxy forwards /api to the backend.
# In production, set this to your deployed backend URL.
# WARNING: anything starting with VITE_ is visible to every visitor. Never put secrets here.
VITE_API_URL=

# Public Firebase web-app configuration (not Firebase Admin credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
