PORT=5000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5174

# Firebase project ID. The server uses Google Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS locally, or the hosting platform's identity).
FIREBASE_PROJECT_ID=mend-and-blend
# one_total or one_per_session
BOOKING_TICKET_LIMIT_POLICY=one_per_session
# Whole minutes, from 1 to 30
BOOKING_HOLD_MINUTES=10

# Only Razorpay Test Mode keys are accepted by the backend.
R   
RAZORPAY_WEBHOOK_SECRET=
# Whole minutes, from 10 to 60
PAYMENT_HOLD_MINUTES=20
